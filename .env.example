# Copy to .env and fill in. .env is gitignored and must stay that way —
# a key that reaches git history has to be rotated, not just deleted.

# Model provider used by the agent under evaluation and by the LLM grader.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hugging Face token with access to the gated futurehouse/BixBench dataset.
HF_TOKEN=
